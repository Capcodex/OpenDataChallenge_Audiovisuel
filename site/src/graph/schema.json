{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph.schema.json",
  "title": "graph.json : données de la carte des médias",
  "description": "Format d'échange entre le pipeline et le site (CdC technique § 8.2). Figé au jalon J3. Valeurs arrondies à 3 décimales.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "nodes", "others", "edges", "communities", "owners", "jt"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "edition",
        "date_traitement",
        "version_pipeline",
        "adresse_site",
        "sources",
        "params",
        "communities_displayed",
        "lift_reference"
      ],
      "properties": {
        "format": {
          "const": 1,
          "description": "Version du format ; changée seulement si le site doit être adapté"
        },
        "edition": {
          "type": "string"
        },
        "date_traitement": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version_pipeline": {
          "type": "string"
        },
        "adresse_site": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "producer", "license", "url"],
            "properties": {
              "name": {
                "type": "string"
              },
              "producer": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "params": {
          "type": "object",
          "description": "Paramètres publiés (config/params.yaml)"
        },
        "communities_displayed": {
          "type": "boolean",
          "description": "RG-07 : faux = carte sans couleurs de famille"
        },
        "lift_reference": {
          "type": "number",
          "description": "Lift dû à la seule intensité de consommation (ADR-005)"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "aliases",
          "type",
          "public",
          "x",
          "y",
          "community",
          "stability",
          "bridge",
          "n",
          "share",
          "fragile",
          "pol",
          "pol_nr",
          "age",
          "under35",
          "trust",
          "trust_gap",
          "group",
          "owners",
          "owner_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "enum": ["radio", "journal", "magazine", "tv", "info", "web", "createur", "jt"]
          },
          "public": {
            "enum": ["public", "prive", "autre", "na"]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "community": {
            "type": "integer",
            "minimum": 1
          },
          "stability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bridge": {
            "type": "boolean"
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fragile": {
            "type": "boolean"
          },
          "pol": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[valeur, borne basse, borne haute] de l'intervalle à 95 %"
          },
          "pol_nr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "age": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[valeur, borne basse, borne haute] de l'intervalle à 95 %"
          },
          "under35": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "[valeur, borne basse, borne haute] de l'intervalle à 95 %"
          },
          "trust": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "[valeur, borne basse, borne haute] de l'intervalle à 95 %"
              },
              {
                "type": "null"
              }
            ]
          },
          "trust_gap": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "[valeur, borne basse, borne haute] de l'intervalle à 95 %"
              },
              {
                "type": "null"
              }
            ]
          },
          "group": {
            "type": ["string", "null"]
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "share"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "share": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "owner_status": {
            "enum": ["base", "correction", "meme_que", "non_identifie"]
          }
        }
      }
    },
    "others": {
      "type": "array",
      "description": "Médias sous le seuil d'affichage (RG-02) : recherche seulement, sans indicateurs",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "aliases", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["s", "t", "lift", "ci", "n", "shown"],
        "properties": {
          "s": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "t": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "lift": {
            "type": "number",
            "exclusiveMinimum": 1
          },
          "ci": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "shown": {
            "type": "boolean",
            "description": "Lien tracé sur la carte (ADR-005)"
          }
        }
      }
    },
    "communities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "color", "size"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "source", "as_of"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": ["personne", "etat", "organisation"]
          },
          "source": {
            "type": "string"
          },
          "as_of": {
            "type": "string"
          }
        }
      }
    },
    "jt": {
      "type": "null",
      "description": "Module JT : sprint 5"
    }
  }
}
