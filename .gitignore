# Données brutes et intermédiaires : téléchargeables, et contiennent des réponses individuelles.
# « /data/ » et non « data/ » : sinon tests/data/ et site/public/data/ seraient aussi ignorés.
/data/

# Environnement
.env
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Front-end
site/node_modules/
site/dist/

# Système
.DS_Store

# Terraform (infra/) : état local et fichiers du fournisseur, jamais versionnés (l'état contient
# des identifiants de ressources). Le verrou des versions (.terraform.lock.hcl) est versionné.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars

# Tests de bout en bout (e2e/)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
# En-têtes HTTP relevés par les contrôles (CI, poste local)
entetes.txt
